{
  "name": "@anonymerniklasistanonym/local-ci",
  "version": "0.1.2b",
  "private": false,
  "description": "run your own local ci for example as part of a git hook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonymerNiklasistanonym/local-ci.git"
  },
  "bin": {
    "local-ci": "dist/cli.mjs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "main": "dist/cli.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.tsx",
    "start": "node .",
    "create:schema": "tsx scripts/createJsonSchema.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "test": "vitest",
    "test:check": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@oliveryasuna/ink-frame-scroll": "^1.0.0",
    "clipboardy": "^5.3.2",
    "commander": "^15.1.0",
    "fullscreen-ink": "^0.1.0",
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "log-update": "^8.0.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "typebox": "^1.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
