{
  "name": "local-ci",
  "version": "0.1.0",
  "private": true,
  "description": "run your own local ci for example as part of a git hook",
  "bin": {
    "local-ci": "./dist/cli.mjs"
  },
  "type": "module",
  "main": "dist/cli.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.tsx",
    "start": "node .",
    "create:schema": "tsx scripts/createJsonSchema.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "test": "vitest",
    "test:check": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@oliveryasuna/ink-frame-scroll": "^1.0.0",
    "commander": "^15.0.0",
    "fullscreen-ink": "^0.1.0",
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "log-update": "^8.0.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
