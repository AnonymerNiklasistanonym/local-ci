{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off",
    "prefer-const": "error",
    "sort-imports": "error",
    "sort-keys": "error",
    "@typescript-eslint/no-explicit-any": "warn"
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**"]
}
